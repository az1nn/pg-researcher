{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pg-researcher.local/schemas/research-report.schema.json",
  "title": "PG Research Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "topic",
    "generated_at",
    "findings",
    "conflicts",
    "source_ledger",
    "strategic_implications",
    "editorial_opportunities",
    "asset_candidates",
    "open_questions",
    "evidence_ids"
  ],
  "properties": {
    "report_id": {"type": "string", "pattern": "^pgr_[A-Za-z0-9_-]+$"},
    "topic": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "scope": {"type": ["string", "null"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "claim_id",
          "statement",
          "epistemic_class",
          "confidence",
          "status",
          "evidence_ids",
          "contradicting_evidence_ids",
          "editorial_lenses"
        ],
        "properties": {
          "finding_id": {"type": "string"},
          "claim_id": {"type": "string", "pattern": "^pgc_[A-Za-z0-9_-]+$"},
          "statement": {"type": "string", "minLength": 1},
          "epistemic_class": {"enum": ["fact", "inference", "editorial_hypothesis"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "status": {"enum": ["open", "supported", "conflicted", "retracted"]},
          "evidence_ids": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "contradicting_evidence_ids": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "editorial_lenses": {
            "type": "array",
            "items": {
              "enum": [
                "identity",
                "catalog",
                "territory",
                "collaboration",
                "production",
                "fashion_visual",
                "business_ip",
                "community"
              ]
            },
            "uniqueItems": true
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conflict_id", "description", "claim_ids", "evidence_ids"],
        "properties": {
          "conflict_id": {"type": "string"},
          "description": {"type": "string", "minLength": 1},
          "claim_ids": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        }
      }
    },
    "source_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "source_class",
          "source_url",
          "captured_at",
          "supports_claim_ids",
          "contradicts_claim_ids"
        ],
        "properties": {
          "evidence_id": {"type": "string"},
          "source_class": {
            "enum": [
              "official",
              "platform_partner",
              "reputable_press",
              "catalog_secondary",
              "community"
            ]
          },
          "source_url": {"type": "string", "format": "uri"},
          "source_title": {"type": ["string", "null"]},
          "source_account": {"type": ["string", "null"]},
          "captured_at": {"type": "string", "format": "date-time"},
          "published_at": {"type": ["string", "null"], "format": "date-time"},
          "supports_claim_ids": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "contradicts_claim_ids": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        }
      }
    },
    "strategic_implications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bridge_id", "claim_ids", "statement"],
        "properties": {
          "bridge_id": {"type": "string"},
          "claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "statement": {"type": "string", "minLength": 1}
        }
      }
    },
    "editorial_opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bridge_id",
          "claim_ids",
          "editorial_format",
          "editorial_lens",
          "concept"
        ],
        "properties": {
          "bridge_id": {"type": "string"},
          "claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "editorial_format": {
            "enum": [
              "prince_no_beat",
              "do_arquivo",
              "o_corre_por_tras",
              "directors_note",
              "prince_responde"
            ]
          },
          "editorial_lens": {
            "enum": [
              "identity",
              "catalog",
              "territory",
              "collaboration",
              "production",
              "fashion_visual",
              "business_ip",
              "community"
            ]
          },
          "concept": {"type": "string", "minLength": 1},
          "objective": {"type": ["string", "null"]}
        }
      }
    },
    "asset_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "usage_basis"],
        "properties": {
          "evidence_id": {"type": "string"},
          "usage_basis": {
            "enum": [
              "artist_authorization",
              "license",
              "permission",
              "research_reference",
              "unknown"
            ]
          },
          "purpose": {"type": ["string", "null"]}
        }
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  }
}
