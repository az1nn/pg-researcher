{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pg-researcher.local/schemas/religion-parallel.schema.json",
  "title": "PG Religion Research Comparative Parallel",
  "type": "object",
  "additionalProperties": false,
  "required": ["parallel_id", "concept", "left_claim_ids", "right_claim_ids", "relation_type", "strength", "historical_dependency_status", "statement"],
  "properties": {
    "parallel_id": {"type": "string", "pattern": "^pgrp_[A-Za-z0-9_-]+$"},
    "concept": {"type": "string", "minLength": 1},
    "left_claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "right_claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "relation_type": {"type": "string", "enum": ["lexical", "structural", "historical", "influence_claim", "editorial"]},
    "strength": {"type": "string", "enum": ["high", "medium", "low"]},
    "historical_dependency_status": {"type": "string", "enum": ["supported", "unsupported", "unresolved", "not_claimed"]},
    "statement": {"type": "string", "minLength": 1},
    "caveats": {"type": "array", "items": {"type": "string"}, "default": []},
    "notes": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"relation_type": {"const": "influence_claim"}}, "required": ["relation_type"]},
      "then": {"properties": {"historical_dependency_status": {"enum": ["supported", "unresolved"]}}}
    }
  ]
}
