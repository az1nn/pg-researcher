{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pg-researcher.local/schemas/claim.schema.json",
  "title": "PG Knowledge Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "subject", "predicate", "value", "epistemic_class", "confidence", "evidence_ids"],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^pgc_[A-Za-z0-9_-]+$"},
    "subject": {"type": "string", "minLength": 1},
    "predicate": {"type": "string", "minLength": 1},
    "value": {},
    "epistemic_class": {"enum": ["fact", "inference", "editorial_hypothesis"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "status": {"enum": ["open", "supported", "conflicted", "retracted"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "contradicting_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "effective_at": {"type": ["string", "null"], "format": "date-time"},
    "effective_until": {"type": ["string", "null"], "format": "date-time"},
    "domain": {"enum": ["identity", "catalog", "release", "track", "collaboration", "production", "territory", "business", "community", "other"]},
    "entity_id": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
